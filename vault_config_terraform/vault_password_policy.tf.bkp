resource "vault_password_policy" "default" {
  # provider = vault.app
  name = "default"
  policy = <<EOT
    length=20
rule "charset" {
  charset = "abcdefghijklmnopqrstuvwxyz"
  min-chars = 1
}
rule "charset" {
  charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  min-chars = 1
}
rule "charset" {
  charset = "0123456789"
  min-chars = 1
}
rule "charset" {
  charset = "!@#$%^&*"
  min-chars = 1
}
  EOT
}

data "vault_generic_secret" "password" {
 #  provider = vault.app
  depends_on = [vault_password_policy.default]
  path = "sys/policies/password/default/generate"
}

resource "vault_kv_secret_v2" "linux" {
  depends_on          = [time_sleep.wait_5_seconds]
 #  provider            = vault.app
  mount               = vault_mount.boundary_creds.path
  name                = "linux-user"
  cas                 = 1
  delete_all_versions = true
  data_json = jsonencode(
    {
      username = "boundary-user",
      password = data.vault_generic_secret.password.data["password"]
    }
  )
}